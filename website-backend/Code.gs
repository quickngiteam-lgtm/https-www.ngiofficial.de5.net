function renderWebsite_(requestedPage, requestedSection) {
  const candidate = String(requestedPage || 'home');
  const page = Object.prototype.hasOwnProperty.call(NGI_HTML_PAGES, candidate) ? candidate : 'home';
  const serviceUrl = ScriptApp.getService().getUrl();
  const url = /^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/(?:exec|dev)$/.test(String(serviceUrl || ''))
    ? serviceUrl : NGI_DEFAULT_WEBSITE_URL;
  const section = String(requestedSection || '');
  let sectionScript = '';
  if (/^[A-Za-z][A-Za-z0-9_-]{0,90}$/.test(section)) {
    sectionScript = '<script>window.addEventListener("load",function(){var el=document.getElementById(' +
      JSON.stringify(section) + ');if(el){el.scrollIntoView({block:"start"});}});<'+ '/script>';
  }
  let documentHtml = NGI_HTML_PAGES[page].split('__NGI_SITE_URL__').join(url)
    .split('__NGI_SECTION_SCRIPT__').join(sectionScript);
  Object.keys(NGI_EMBEDDED_STYLES).forEach(key => {
    if (documentHtml.indexOf(key) !== -1) documentHtml = documentHtml.split(key).join(NGI_EMBEDDED_STYLES[key]);
  });
  Object.keys(NGI_EMBEDDED_IMAGES).forEach(key => {
    if (documentHtml.indexOf(key) !== -1) documentHtml = documentHtml.split(key).join(NGI_EMBEDDED_IMAGES[key]);
  });
  documentHtml = documentHtml
    .replace('</head>', '<style>' + NGI_WHATSAPP_HELP_CSS + '</style></head>')
    .replace('</body>', NGI_WHATSAPP_HELP_HTML + '</body>');
  return HtmlService.createHtmlOutput(documentHtml)
    .setTitle(NGI_PAGE_TITLES[page])
    .addMetaTag('viewport','width=device-width,initial-scale=1');
}
