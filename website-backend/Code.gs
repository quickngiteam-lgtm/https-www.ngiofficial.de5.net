s=\"skip-link\" href=\"#main\" target=\"_self\">Skip to content</a>\n\n<header class=\"site-header\"><div class=\"brand-block\">\n<div class=\"w brand-container\">\n<div class=\"brand-row\">\n<div class=\"brand-logo\">\n<img src=\"https://lh3.googleusercontent.com/d/1S5-QYFSCaPwLxHTXR51VhfiXbAkokHvd\" alt=\"NGI Logo\" onerror=\"this.style.display='none';this.parentNode.innerHTML='NGI'\">\n</div>\n<div class=\"brand-text\">\n<div class=\"brand-title\">NEXT GENERATION<br>INITIATIVE (NGI)</div>\n<div class=\"brand-tagline\">Empowering Youth. Transforming Communities.</div>\n</div>\n</div>\n</div>\n</div>\n\n\n<nav aria-label=\"Main navigation\" class=\"main-nav\"><div class=\"nav-inner\"><button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"nav-links\"><span aria-hidden=\"true\">☰</span> Menu</button><div id=\"nav-links\" class=\"nav-links\"><a href=\"__NGI_SITE_URL__?page=home\">Home</a><a href=\"__NGI_SITE_URL__?page=about\">About NGI</a><a href=\"__NGI_SITE_URL__?page=vision-mission\">Vision &amp; Mission</a><a href=\"__NGI_SITE_URL__?page=leadership\">Leadership</a><a href=\"__NGI_SITE_URL__?page=membership\">NGI Membership</a><a href=\"__NGI_SITE_URL__?page=ufaq\" aria-current=\"page\">UFAQ Volunteer Application</a></div></div></nav>\n</header>\n<main id=\"main\"><style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap');\n\n#ufaqWrap{font-family:'Plus Jakarta Sans',Arial,sans-serif;background:linear-gradient(135deg,#f0fdf4 0%,#f8fafc 100%);padding:40px 4%;box-sizing:border-box}\n#ufaqWrap *{box-sizing:border-bo",
    "x}\n\n/* ===== FRONT / LANDING SECTION ===== */\n.ufaq-landing{max-width:820px;margin:0 auto 28px;background:#ffffff;border-radius:18px;padding:34px;border-top:6px solid #0A1F3D;box-shadow:0 12px 40px rgba(10,31,61,.09);animation:landingFadeIn .6s ease-out both}\n@keyframes landingFadeIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}\n\n.ufaq-top-header{text-align:center;margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid #E2E8F0}\n.ufaq-main-title{font-family:'Playfair Display',Georgia,serif;font-size:42px;font-weight:900;color:#0A1F3D;margin:0 0 6px;letter-spacing:2px;line-height:1.1}\n.ufaq-main-subtitle{font-size:15.5px;font-weight:800;color:#0D9488;margin:0 0 6px;letter-spacing:.3px;line-height:1.45}\n.ufaq-form-subtitle{font-size:14px;font-weight:700;color:#475569;margin:0;letter-spacing:.4px;text-transform:uppercase}\n.ufaq-landing-bar{width:84px;height:4px;background:linear-gradient(90deg,#0A1F3D 0%,#0D9488 100%);border-radius:3px;margin:12px auto 0}\n\n.ufaq-logos-bar{display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap;margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid #E2E8F0}\n.ufaq-logo-item{display:flex;flex-direction:column;align-items:center;gap:6px;max-width:210px;text-align:center}\n.ufaq-logo-item img{height:76px;width:auto;max-width:190px;object-fit:contain;display:block}\n.ufaq-logo-caption{font-size:11.5px;font-weight:800;color:#0A1F3D;letter-spacing:.3px}\n.ufaq-logo-divider{width:1px;height:64px;background:#CBD5E1}\n\n.ufaq-intro-box{background:#F0FDFA;border:1px solid #99F6E4;border-left:4px solid #0D9488;border-radius:10px;padding:15px 18px;margin-bottom:24px;text-align:center}\n.ufaq-intro-box p{margin:0;font-size:14.5px;color:#0A1F3D;line-height:1.65;font-weight:600}\n\n.ufaq-sec-heading{font-family:'Playfair Display',Georgia,serif;font-size:20px;font-weight:900;color:#0A1F3D;text-align:center;margin:0 0 14px}\n\n.ufaq-themes-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:26px}\n.ufaq-theme-card{background:#ffffff;border:1.5px solid #CCFBF1;border-top:4px solid #0D9488;border-radius:12px;padding:18px 16px;display:flex;align-items:center;gap:14px;box-shadow:0 4px 14px rgba(10,31,61,.05);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}\n.ufaq-theme-card:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(13,148,136,.14);border-color:#0D9488}\n.ufaq-theme-icon{width:46px;height:46px;min-width:46px;border-radius:11px;background:linear-gradient(135deg,#0A1F3D 0%,#0D9488 100%);color:#ffffff;display:flex;align-items:center;justify-content:center}\n.ufaq-theme-icon svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.ufaq-theme-num{font-size:11px;font-weight:800;color:#0D9488;text-transform:uppercase;letter-spacing:.6px;display:block;margin-bottom:2px}\n.ufaq-theme-title{font-size:15px;font-weight:800;color:#0A1F3D;margin:0;line-height:1.35}\n\n.ufaq-struct-wrap{background:#F8FAFC;border:1px solid #E2E8F0;border-radius:14px;padding:20px 18px;margin-bottom:22px;text-align:center}\n.ufaq-struct-flow{max-width:520px;margin:0 auto;display:flex;flex-direction:column;align-items:center}\n.ufaq-node{width:100%;padding:11px 16px;border-radius:10px;font-size:13.5px;font-weight:800;line-height:1.4}\n.ufaq-node-owner{background:#0A1F3D;color:#ffffff;box-shadow:0 4px 12px rgba(10,31,61,.16)}\n.ufaq-node-prog{background:#0D9488;color:#ffffff}\n.ufaq-node-par",
    "tner{background:#ffffff;color:#0A1F3D;border:1.5px solid #0D9488}\n.ufaq-node-vol{background:#F0FDFA;color:#0A1F3D;border:1px solid #99F6E4}\n.ufaq-arrow{font-size:18px;font-weight:900;color:#0D9488;line-height:1.2;padding:4px 0}\n.ufaq-struct-note{margin:14px auto 0;max-width:640px;font-size:12.5px;color:#334155;line-height:1.6;font-weight:600}\n\n.ufaq-tagline-strip{text-align:center;padding:12px 14px;background:linear-gradient(90deg,#0A1F3D 0%,#0F3460 50%,#0D9488 100%);color:#ffffff;border-radius:10px;font-size:13.5px;font-weight:800;letter-spacing:.5px;margin-bottom:20px}\n\n.ufaq-cta-wrap{text-align:center}\n.ufaq-apply-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#0D9488 0%,#047857 100%);color:#ffffff;text-decoration:none;border:none;font-family:inherit;font-size:15.5px;font-weight:800;padding:15px 34px;border-radius:11px;cursor:pointer;box-shadow:0 8px 22px rgba(13,148,136,.32);transition:transform .2s ease,box-shadow .2s ease}\n.ufaq-apply-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(13,148,136,.4)}\n\n/* ===== APPLICATION FORM STYLES ===== */\n#ufaqWrap .u-card{max-width:820px;margin:0 auto;background:#fff;border-radius:18px;padding:34px;border-top:6px solid #047857;box-shadow:0 12px 40px rgba(0,0,0,.08)}\n#ufaqWrap h3{font-family:'Playfair Display',Georgia,serif;font-size:18px;color:#0A1F3D;border-bottom:2px solid #E2E8F0;padding-bottom:6px;margin:0 0 14px}\n#ufaqWrap .u-sec{margin-bottom:26px}\n#ufaqWrap .u-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}\n#ufaqWrap .u-row{margin-bottom:12px}\n#ufaqWrap label.u-lab{display:block;font-size:12px;font-weight:800;color:#0A1F3D;margin-bottom:4px}\n#ufaqWrap .u-in{width:100%;padding:10px;border:1px solid #CBD5E1;border-radius:7px;font-size:14px;background:#fff;font-family:inherit;transition:.2s}\n#ufaqWrap .u-in:focus{outline:2px solid #04785755;border-color:#047857}\n#ufaqWrap .u-file-box{background:#F8FAFC;border:1.5px dashed #94A3B8;border-radius:9px;padding:14px;transition:.2s}\n#ufaqWrap .u-file-box:hover{border-color:#0D9488;background:#F0FDFA}\n#ufaqWrap .u-file-hint{display:block;font-size:12px;color:#475569;margin-top:6px;font-weight:600}\n#ufaqWrap .u-file-status{display:block;font-size:12px;color:#047857;margin-top:5px;font-weight:700}\n#ufaqWrap .u-chk{display:block;margin-bottom:10px;cursor:pointer;font-size:13px;color:#334155;line-height:1.6}\n#ufaqWrap .u-chk input{margin-right:8px}\n\n/* ===== SUBMIT BUTTON & LOADING ANIMATION ===== */\n#ufaqWrap #submitBtn{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,#047857 0%,#059669 100%);color:#fff;border:none;font-size:15.5px;font-weight:800;padding:15px;border-radius:10px;cursor:pointer;width:100%;box-shadow:0 6px 20px rgba(4,120,87,.3);transition:all .25s ease}\n#ufaqWrap #submitBtn:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 8px 24px rgba(4,120,87,.4)}\n#ufaqWrap #submitBtn.is-loading{background:linear-gradient(110deg,#0A1F3D 0%,#0D9488 45%,#0A1F3D 90%);background-size:200% 100%;animation:navyTealShimmer 1.6s linear infinite,navyTealGlow 1.6s ease-in-out infinite;cursor:not-allowed;opacity:1}\n@keyframes navyTealShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}\n@keyframes navyTealGlow{0%,100%{box-shadow:0 4px 16px rgba(10,31,61,.35)}50%{box-shadow:0 6px 26px rgba(13,148,136,.55)}}\n.ufaq-spinner{width:18px;height:1",
    "8px;border:2.5px solid rgba(255,255,255,.3);border-top-color:#ffffff;border-radius:50%;animation:ufaqSpin .75s linear infinite;display:inline-block;flex-shrink:0}\n@keyframes ufaqSpin{to{transform:rotate(360deg)}}\n\n/* ===== FOUNDATION BANNER & HEADER ===== */\n.apf-banner{text-align:center;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid #E2E8F0}\n.apf-name{font-family:'Playfair Display',Georgia,serif;font-size:32px;font-weight:900;color:#0A1F3D;margin:0 0 6px;letter-spacing:.3px;line-height:1.2}\n.apf-line{width:90px;height:4px;background:#047857;border-radius:3px;margin:0 auto 8px}\n.apf-sub{font-size:14.5px;font-weight:700;color:#047857;margin:0;letter-spacing:.4px}\n\n.ufaq-hero{text-align:center;margin-bottom:20px;position:relative;overflow:hidden;padding:4px 0}\n.ufaq-badge{display:inline-block;background:#ECFDF5;color:#047857;border:1px solid #A7F3D0;font-size:11.5px;font-weight:800;letter-spacing:1.2px;padding:4px 12px;border-radius:20px;margin-bottom:8px;text-transform:uppercase}\n.ufaq-hero .proj-title{font-family:'Playfair Display',Georgia,serif;font-size:26px;font-weight:900;color:#0A1F3D;margin:0 0 6px;display:flex;justify-content:center;flex-wrap:wrap;gap:2px}\n.ufaq-hero .proj-title span{display:inline-block;opacity:0;transform:translateY(14px);animation:letterIn .5s forwards}\n@keyframes letterIn{to{opacity:1;transform:translateY(0)}}\n.ufaq-hero .ngi-line{font-size:13px;color:#475569;font-weight:700;margin:0}\n.ufaq-hero .pulse-line{width:70px;height:3px;background:#047857;border-radius:3px;margin:12px auto 0;animation:pulseLine 2s ease-in-out infinite}\n@keyframes pulseLine{0%,100%{width:70px;opacity:1}50%{width:120px;opacity:.6}}\n\n/* ===== NOTICES & GUARDIAN BOX ===== */\n.partner-box{background:#F0FDF4;border-left:4px solid #047857;border-top:1px solid #BBF7D0;border-right:1px solid #BBF7D0;border-bottom:1px solid #BBF7D0;padding:14px 16px;border-radius:8px;margin-bottom:18px}\n.partner-box p{margin:0;font-size:13px;color:#065F46;line-height:1.55;font-weight:600}\n\n.notice-box{background:#FEF2F2;border-left:4px solid #DC2626;padding:14px 16px;border-radius:8px;margin-bottom:24px}\n.notice-box h4{margin:0 0 6px;color:#991B1B;font-size:13.5px;text-transform:uppercase}\n.notice-box p{margin:0;font-size:12.5px;color:#7F1D1D;line-height:1.55}\n\n.guardian-box{display:none;background:#FFFBEB;border:1px solid #FCD34D;border-left:4px solid #D97706;padding:16px;border-radius:10px;margin-top:14px}\n.guardian-box h4{margin:0 0 10px;color:#92400E;font-size:14px;font-weight:800}\n\n.privacy-box{background:#F8FAFC;border:1px solid #CBD5E1;border-left:4px solid #0A1F3D;padding:14px 16px;border-radius:8px;margin-bottom:16px}\n.privacy-box h4{margin:0 0 6px;color:#0A1F3D;font-size:13px;font-weight:800;text-transform:uppercase}\n.privacy-box p{margin:0 0 10px;font-size:12.5px;color:#334155;line-height:1.55}\n\n.ufaq-hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none}\n\n@media(max-width:600px){\n #ufaqWrap{padding:20px 3%}\n .ufaq-landing{padding:22px 18px}\n .ufaq-main-title{font-size:32px}\n .ufaq-main-subtitle{font-size:14px}\n .ufaq-logos-bar{gap:16px}\n .ufaq-logo-divider{display:none}\n .ufaq-logo-item img{height:64px}\n .ufaq-themes-grid{grid-template-columns:1fr}\n .ufaq-tagline-strip{font-size:12px}\n .ufaq-apply-btn{width:100%}\n #ufaqWrap .u-card{padding:20px}\n #ufaqWrap .u-grid{grid-template-columns:1fr}\n .apf-name{font-size:25px}\n .ufaq-hero .proj-title{font-size:21px}\n}\n</style>\n\n<div id=\"ufaqWrap\">\n\n<!-- ===== FR",
    "ONT / LANDING PAGE SECTION ===== -->\n<section class=\"ufaq-landing\" aria-label=\"UFAQ Programme Overview\">\n\n  <!-- 1. TOP HEADER (ABOVE LOGOS) -->\n  <div class=\"ufaq-top-header\">\n    <h1 class=\"ufaq-main-title\">UFAQ</h1>\n    <p class=\"ufaq-main-subtitle\">Youth Led Partnership programme by Amarta Peace Foundation.</p>\n    <p class=\"ufaq-form-subtitle\">Volunteer Application Form</p>\n    <div class=\"ufaq-landing-bar\"></div>\n  </div>\n\n  <!-- 2. OFFICIAL LOGOS -->\n  <div class=\"ufaq-logos-bar\">\n    <div class=\"ufaq-logo-item\">\n      <img src=\"https://lh3.googleusercontent.com/d/1FXvRiRrjffiosJwVFdJ1gJAmH9G_MQHV\"\n           onerror=\"if(!this.dataset.fb){this.dataset.fb='1';this.src='https://drive.google.com/thumbnail?id=1FXvRiRrjffiosJwVFdJ1gJAmH9G_MQHV&sz=w600';}\"\n           alt=\"Amarta Peace Foundation Official Logo\">\n      <span class=\"ufaq-logo-caption\">Amarta Peace Foundation</span>\n    </div>\n    <div class=\"ufaq-logo-divider\" aria-hidden=\"true\"></div>\n    <div class=\"ufaq-logo-item\">\n      <img src=\"https://lh3.googleusercontent.com/d/1DlgcgbuW9GtEaB3Kta9rL82X6_Keby8d\"\n           onerror=\"if(!this.dataset.fb){this.dataset.fb='1';this.src='https://drive.google.com/thumbnail?id=1DlgcgbuW9GtEaB3Kta9rL82X6_Keby8d&sz=w600';}\"\n           alt=\"NGI - Next Generation Initiative Official Logo\">\n      <span class=\"ufaq-logo-caption\">NGI &#8211; Next Generation Initiative</span>\n    </div>\n  </div>\n\n  <!-- 3. SHORT PROGRAMME INTRODUCTION -->\n  <div class=\"ufaq-intro-box\">\n    <p>UFAQ is a flagship programme of Amarta Peace Foundation, implemented in partnership with NGI (Next Generation Initiative), an independent, student-led youth initiative.</p>\n  </div>\n\n  <!-- 4. OUR FOUR MAIN THEMES -->\n  <h2 class=\"ufaq-sec-heading\">Our Four Main Themes</h2>\n  <div class=\"ufaq-themes-grid\">\n    <div class=\"ufaq-theme-card\">\n      <div class=\"ufaq-theme-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2a7 7 0 0 1 4 12.75V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.25A7 7 0 0 1 12 2z\"/><path d=\"M9 21h6\"/><path d=\"M10 18v3\"/><path d=\"M14 18v3\"/></svg>\n      </div>\n      <div>\n        <span class=\"ufaq-theme-num\">Theme 01</span>\n        <h3 class=\"ufaq-theme-title\">Social Awareness</h3>\n      </div>\n    </div>\n\n    <div class=\"ufaq-theme-card\">\n      <div class=\"ufaq-theme-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"/><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/></svg>\n      </div>\n      <div>\n        <span class=\"ufaq-theme-num\">Theme 02</span>\n        <h3 class=\"ufaq-theme-title\">Peace and Civic Education</h3>\n      </div>\n    </div>\n\n    <div class=\"ufaq-theme-card\">\n      <div class=\"ufaq-theme-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n      </div>\n      <div>\n        <span class=\"ufaq-theme-num\">Theme 03</span>\n        <h3 class=\"ufaq-theme-title\">Human Rights</h3>\n      </div>\n    </div>\n\n    <div class=\"ufaq-theme-card\">\n      <div class=\"ufaq-theme-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n      </div>\n      <div>\n        <span class=\"ufaq-theme-num\">Theme 04</span>\n        <h3 class=\"ufaq-theme-title\">Democracy and Youth Participation</h3>\n      </div>\n    </div>\n  </div>\n\n  <!-- 5. ORGA",
    "NIZATIONAL STRUCTURE -->\n  <div class=\"ufaq-struct-wrap\">\n    <h2 class=\"ufaq-sec-heading\">Organizational Structure</h2>\n    <div class=\"ufaq-struct-flow\">\n      <div class=\"ufaq-node ufaq-node-owner\">Amarta Peace Foundation</div>\n      <div class=\"ufaq-arrow\" aria-hidden=\"true\">&#8595;</div>\n      <div class=\"ufaq-node ufaq-node-prog\">UFAQ &#8211; Flagship Programme</div>\n      <div class=\"ufaq-arrow\" aria-hidden=\"true\">&#8595;</div>\n      <div class=\"ufaq-node ufaq-node-partner\">NGI &#8211; Next Generation Initiative (Independent Youth Initiative and Implementation Partner)</div>\n      <div class=\"ufaq-arrow\" aria-hidden=\"true\">&#8595;</div>\n      <div class=\"ufaq-node ufaq-node-vol\">Volunteers / Youth Participants</div>\n    </div>\n    <p class=\"ufaq-struct-note\"><strong>UFAQ</strong> is a flagship programme belonging to <strong>Amarta Peace Foundation</strong>, while <strong>NGI (Next Generation Initiative)</strong> is an independent, student-led youth initiative working in partnership with Amarta Peace Foundation to implement the programme.</p>\n  </div>\n\n  <!-- 6. TAGLINE -->\n  <div class=\"ufaq-tagline-strip\">\n    Empowering Youth &nbsp;|&nbsp; Educating Society &nbsp;|&nbsp; Inspiring Change\n  </div>\n\n  <!-- 7. APPLY BUTTON -->\n  <div class=\"ufaq-cta-wrap\">\n    <button type=\"button\" class=\"ufaq-apply-btn\" id=\"ufaqJumpApplyBtn\" onclick=\"var el=document.getElementById('formCard');if(el){el.scrollIntoView({behavior:'smooth',block:'start'});}\">\n      Apply as a Volunteer &#8595;\n    </button>\n  </div>\n\n</section>\n\n<!-- ===== APPLICATION FORM SECTION ===== -->\n<div style=\"max-width:820px;margin:0 auto\">\n\n<div id=\"formAlertBox\" style=\"display:none;padding:16px;border-radius:10px;margin-bottom:20px;font-weight:700;text-align:center;font-size:14px;box-shadow:0 4px 12px rgba(0,0,0,.05)\"></div>\n\n<div id=\"formCard\" class=\"u-card\">\n\n<!-- PROMINENT FOUNDATION BANNER -->\n<div class=\"apf-banner\">\n  <h1 class=\"apf-name\">Amarta Peace Foundation</h1>\n  <div class=\"apf-line\"></div>\n  <p class=\"apf-sub\">Presents the UFAQ Programme</p>\n</div>\n\n<!-- FORM TITLE & NGI SUBTITLE -->\n<div class=\"ufaq-hero\">\n  <span class=\"ufaq-badge\">UFAQ</span>\n  <h2 class=\"proj-title\" id=\"projTitle\">Volunteer Application Form</h2>\n  <p class=\"ngi-line\">Volunteer recruitment by Next Generation Initiative (NGI)</p>\n  <div class=\"pulse-line\"></div>\n</div>\n\n<!-- PARTNER NOTE -->\n<div class=\"partner-box\">\n  <p>UFAQ is a flagship programme of Amarta Peace Foundation, which supports the programme. Next Generation Initiative (NGI), an independent, unincorporated, student-led youth initiative, invites volunteers for this programme in partnership with the Foundation.</p>\n</div>\n\n<!-- IMPORTANT NOTICE -->\n<div class=\"notice-box\">\n  <h4>Important Notice &#8211; Volunteer Opportunity</h4>\n  <p>This is a voluntary opportunity. Participation alone does not entitle a volunteer to any salary, stipend, TA/DA, allowance or other financial compensation. A benefit applies only if it is provided in the written policy or programme agreement of Amarta Peace Foundation, and it will be communicated to selected volunteers before their participation is confirmed. By submitting this application, you acknowledge and agree to these terms.</p>\n</div>\n\n<form id=\"ufaqForm\" method=\"post\" autocomplete=\"on\" novalidate>\n\n<!-- HONEYPOT ANTI-SPAM FIELD -->\n<div class=\"ufaq-hp\" aria-hidden=\"true\">\n  <label for=\"websiteHp\">Website</label>\n  <input type=\"text\" id=\"websiteHp\" name=\"website\" tabindex=\"-1\" autocomplet",
    "e=\"off\">\n</div>\n\n<!-- 1. PERSONAL -->\n<div class=\"u-sec\">\n<h3>1. Personal Information</h3>\n<div class=\"u-grid\">\n<div><label class=\"u-lab\">Full Name *</label><input class=\"u-in\" name=\"Full_Name\" type=\"text\" maxlength=\"100\" required></div>\n<div><label class=\"u-lab\">Gender *</label>\n<select class=\"u-in\" name=\"Gender\" required><option value=\"\">Select</option><option>Male</option><option>Female</option><option>Other</option></select></div>\n</div>\n<div class=\"u-grid\">\n<div><label class=\"u-lab\">Date of Birth * (17+)</label>\n<div style=\"display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:6px\">\n<select class=\"u-in\" id=\"dobDay\" required><option value=\"\">Day</option></select>\n<select class=\"u-in\" id=\"dobMonth\" required><option value=\"\">Month</option></select>\n<select class=\"u-in\" id=\"dobYear\" required><option value=\"\">Year</option></select>\n</div>\n<input type=\"hidden\" id=\"dobField\" name=\"Date_of_Birth\"></div>\n<div><label class=\"u-lab\">WhatsApp Number * (Pakistan)</label><input class=\"u-in\" id=\"whatsappInput\" name=\"WhatsApp_Number\" type=\"tel\" maxlength=\"13\" required placeholder=\"03001234567 or +923001234567\"></div>\n</div>\n\n<!-- UNDER-18 GUARDIAN CONSENT BOX -->\n<div id=\"guardianBox\" class=\"guardian-box\">\n  <h4>Guardian Consent (required for applicants under 18)</h4>\n  <div class=\"u-grid\">\n    <div><label class=\"u-lab\">Guardian Full Name *</label><input class=\"u-in\" id=\"guardianName\" name=\"Guardian_Full_Name\" type=\"text\" maxlength=\"100\"></div>\n    <div><label class=\"u-lab\">Relationship *</label>\n      <select class=\"u-in\" id=\"guardianRelation\" name=\"Guardian_Relationship\">\n        <option value=\"\">Select Relationship</option>\n        <option>Father</option>\n        <option>Mother</option>\n        <option>Elder Brother / Sister</option>\n        <option>Legal Guardian</option>\n      </select>\n    </div>\n  </div>\n  <div class=\"u-row\">\n    <label class=\"u-lab\">Guardian Phone * (Pakistan)</label>\n    <input class=\"u-in\" id=\"guardianPhone\" name=\"Guardian_Phone\" type=\"tel\" maxlength=\"13\" placeholder=\"03001234567 or +923001234567\">\n  </div>\n  <label class=\"u-chk\" style=\"margin-bottom:0\">\n    <input type=\"checkbox\" id=\"guardianConfirm\" name=\"Guardian_Consent_Confirmed\" value=\"Yes\">\n    My parent/guardian knows about and gives written permission for my participation as a volunteer.\n  </label>\n</div>\n\n<div class=\"u-row\" style=\"margin-top:12px\"><label class=\"u-lab\">Email Address *</label><input class=\"u-in\" name=\"Email_Address\" type=\"email\" maxlength=\"150\" required placeholder=\"name@example.com\"></div>\n<div class=\"u-grid\">\n<div><label class=\"u-lab\">District *</label>\n<select class=\"u-in\" name=\"District\" required>\n<option value=\"\">Select District</option>\n<option>Mirpurkhas</option><option>Tharparkar</option><option>Umerkot</option><option>Sanghar</option><option>Hyderabad</option><option>Karachi</option><option>Sukkur</option><option>Larkana</option><option>Shaheed Benazirabad (Nawabshah)</option><option>Jamshoro</option><option>Dadu</option><option>Badin</option><option>Thatta</option><option>Sujawal</option><option>Matiari</option><option>Tando Allahyar</option><option>Tando Muhammad Khan</option><option>Khairpur</option><option>Naushahro Feroze</option><option>Ghotki</option><option>Shikarpur</option><option>Jacobabad</option><option>Kashmore</option><option>Kambar Shahdadkot</option><option>Other</option>\n</select></div>\n<div><label class=\"u-lab\">City *</label><input class=\"u-in\" name=\"City\" type=\"text\" maxlength=\"80\" required placeholder=\"e.g. Mirpurkhas\"",
    "></div>\n</div>\n<div class=\"u-row\"><label class=\"u-lab\">Complete Address *</label><input class=\"u-in\" name=\"Complete_Address\" type=\"text\" maxlength=\"250\" required placeholder=\"House / Street / Area\"></div>\n</div>\n\n<!-- 2. EDUCATION -->\n<div class=\"u-sec\">\n<h3>2. Educational Information</h3>\n<div class=\"u-grid\" style=\"margin-bottom:0\">\n<div><label class=\"u-lab\">Education Level *</label>\n<select class=\"u-in\" name=\"Education_Level\" required><option value=\"\">Select Level</option><option>Matric</option><option>Intermediate</option><option>Undergraduate / Bachelor's</option><option>Graduate / Master's</option><option>Other</option></select></div>\n<div><label class=\"u-lab\">Institution Name *</label><input class=\"u-in\" name=\"Institution_Name\" type=\"text\" maxlength=\"150\" required></div>\n</div>\n</div>\n\n<!-- 3. VOLUNTEER -->\n<div class=\"u-sec\">\n<h3>3. Volunteer Information</h3>\n<div class=\"u-grid\">\n<div><label class=\"u-lab\">Preferred Role *</label>\n<select class=\"u-in\" name=\"Preferred_Role\" required><option value=\"\">Select Role</option><option>Field Volunteer</option><option>Education Volunteer</option><option>Awareness Volunteer</option><option>Media &amp; Communication</option><option>Social Media Management</option><option>Event Management</option><option>Research &amp; Documentation</option><option>General Volunteer</option></select></div>\n<div><label class=\"u-lab\">Previous Experience? *</label>\n<select class=\"u-in\" name=\"Previous_Experience\" required><option value=\"\">Select</option><option>Yes</option><option>No</option></select></div>\n</div>\n<div class=\"u-row\"><label class=\"u-lab\">Skills *</label><input class=\"u-in\" name=\"Skills\" type=\"text\" maxlength=\"200\" required placeholder=\"e.g. Graphic design, public speaking, writing\"></div>\n<div><label class=\"u-lab\">Why do you want to join the UFAQ Programme? *</label><textarea class=\"u-in\" name=\"Reason_to_Join\" rows=\"3\" maxlength=\"1500\" required placeholder=\"Write briefly...\"></textarea></div>\n</div>\n\n<!-- 4. AVAILABILITY -->\n<div class=\"u-sec\">\n<h3>4. Availability</h3>\n<div class=\"u-grid\" style=\"margin-bottom:0\">\n<div><label class=\"u-lab\">Hours / Week *</label><input class=\"u-in\" name=\"Hours_Per_Week\" type=\"text\" maxlength=\"30\" required placeholder=\"e.g. 5-10\"></div>\n<div><label class=\"u-lab\">Can you travel within district? *</label>\n<select class=\"u-in\" name=\"Travel_Within_District\" required><option value=\"\">Select</option><option>Yes</option><option>No</option></select></div>\n</div>\n</div>\n\n<!-- 5. EMERGENCY -->\n<div class=\"u-sec\">\n<h3>5. Emergency Contact</h3>\n<div class=\"u-grid\" style=\"margin-bottom:0\">\n<div><label class=\"u-lab\">Contact Name *</label><input class=\"u-in\" name=\"Emergency_Contact_Name\" type=\"text\" maxlength=\"100\" required></div>\n<div><label class=\"u-lab\">Contact Number * (Pakistan)</label><input class=\"u-in\" id=\"emergencyPhoneInput\" name=\"Emergency_Contact_Number\" type=\"tel\" maxlength=\"13\" required placeholder=\"03001234567 or +923001234567\"></div>\n</div>\n</div>\n\n<!-- 6. REQUIRED DOCUMENTS (CV ONLY) -->\n<div class=\"u-sec\">\n<h3>6. Required Documents</h3>\n<div class=\"u-file-box\">\n  <label class=\"u-lab\" for=\"cvFileInput\">Upload CV / Resume (PDF, DOCX, DOC, JPG, PNG &#8212; Max 500 KB) *</label>\n  <input class=\"u-in\" id=\"cvFileInput\" type=\"file\" accept=\".pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png\" required style=\"padding:8px\">\n  <span class=\"u-file-hint\">Allowed formats: P",
    "DF, DOCX, DOC, JPG, PNG &bull; Maximum size: 500 KB</span>\n  <span class=\"u-file-status\" id=\"cvFileStatus\"></span>\n</div>\n</div>\n\n<!-- 7. PRIVACY & DECLARATION -->\n<div class=\"u-sec\">\n<h3>7. Privacy Notice &amp; Declaration</h3>\n\n<div class=\"privacy-box\">\n  <h4>Privacy Notice</h4>\n  <p>Your information is collected only for volunteer selection, communication and records of the UFAQ Programme. It will be seen only by authorized NGI team members and, where needed for the programme, by Amarta Peace Foundation.</p>\n  <label class=\"u-chk\" style=\"margin-bottom:0;font-weight:700;color:#0A1F3D\">\n    <input type=\"checkbox\" name=\"Privacy_Consent\" value=\"Agreed\" required> I have read the Privacy Notice and consent to the use of my information for these purposes.\n  </label>\n</div>\n\n<label class=\"u-chk\"><input type=\"checkbox\" name=\"Accuracy_Declaration\" value=\"Agreed\" required> I confirm that all information provided is accurate and correct.</label>\n<label class=\"u-chk\" style=\"margin-bottom:0\"><input type=\"checkbox\" name=\"Compensation_Policy_Agreed\" value=\"Agreed\" required> I understand that participation alone does not create any entitlement to financial compensation, and that any benefit applies only as stated in the written policy or agreement of Amarta Peace Foundation.</label>\n</div>\n\n<button id=\"submitBtn\" type=\"submit\" disabled>Submit Application</button>\n</form>\n</div>\n\n<!-- SUCCESS POPUP -->\n<div id=\"successPopup\" style=\"display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.6);z-index:99999;justify-content:center;align-items:center;padding:20px;overflow-y:auto\">\n<div style=\"background:#fff;max-width:520px;width:100%;border-radius:16px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,.2);border-top:6px solid #047857;text-align:center;margin:auto\">\n<div style=\"width:60px;height:60px;border-radius:50%;background:#ECFDF5;color:#047857;font-size:30px;line-height:60px;margin:0 auto 12px;font-weight:900\">&#10003;</div>\n<div style=\"font-family:'Playfair Display',Georgia,serif;font-size:25px;font-weight:900;color:#0A1F3D;margin:0 0 4px\">Amarta Peace Foundation</div>\n<div style=\"font-size:12.5px;font-weight:800;color:#047857;text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px\">UFAQ Programme</div>\n<h2 style=\"font-family:'Playfair Display',Georgia,serif;margin:0 0 10px;color:#0A1F3D;font-size:22px;font-weight:900\">&#127881; Submitted Successfully!</h2>\n<div id=\"appIdBadge\" style=\"display:none;background:#F0FDFA;border:1.5px solid #0D9488;color:#0A1F3D;padding:8px 14px;border-radius:8px;font-size:13.5px;font-weight:800;margin:0 auto 12px;max-width:300px\"></div>\n<p style=\"margin:0 0 12px;font-size:14px;color:#334155;line-height:1.6;font-weight:600\">Your volunteer application has been successfully submitted to Next Generation Initiative (NGI) for UFAQ, a flagship programme of Amarta Peace Foundation.</p>\n<p style=\"margin:0 0 14px;font-size:13.5px;color:#475569;line-height:1.6\">Our relevant team will review your application and contact you at your provided WhatsApp number or email address.</p>\n<p style=\"margin:0 0 14px;font-size:12px;color:#64748B;font-style:italic;line-height:1.6;background:#F8FAFC;padding:10px;border-radius:8px;border-left:3px solid #64748B;text-align:left\">\nNote: Next Generation Initiative (NGI) is an independent, unincorporated, student-led youth initiative inviting volunteers in partnership with Amarta Peace Foundation.\n</p>\n<p style=\"margin:0 0 18px;font-size:13.5px;color:#047857;font-weigh",
    "t:700;font-style:italic\">Together, We Can Make a Difference.</p>\n<div style=\"border-top:1px solid #E2E8F0;padding-top:12px;font-size:12.5px;color:#64748B;font-weight:700\">Team NGI | In Partnership with Amarta Peace Foundation</div>\n<button id=\"popupCloseBtn\" type=\"button\" style=\"margin-top:18px;background:#047857;color:#fff;border:none;padding:10px 26px;border-radius:8px;font-weight:800;cursor:pointer\">Close</button>\n</div>\n</div>\n\n<!-- DUPLICATE SUBMISSION POPUP -->\n<div id=\"duplicatePopup\" style=\"display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(10,31,61,.68);z-index:100000;justify-content:center;align-items:center;padding:20px;overflow-y:auto\">\n<div style=\"background:#fff;max-width:460px;width:100%;border-radius:16px;padding:30px;box-shadow:0 20px 40px rgba(0,0,0,.25);border-top:6px solid #DC2626;text-align:center;margin:auto\">\n<div style=\"width:62px;height:62px;border-radius:50%;background:#FEF2F2;color:#DC2626;font-size:32px;line-height:62px;margin:0 auto 14px;font-weight:900\">&#9888;</div>\n<h2 style=\"font-family:'Playfair Display',Georgia,serif;margin:0 0 10px;color:#991B1B;font-size:23px;font-weight:900\">You Already Submitted This Form</h2>\n<p id=\"dupPopupText\" style=\"margin:0 0 20px;font-size:14px;color:#475569;line-height:1.6\">Our records show that an application with this email address or phone number has already been submitted. Duplicate submissions are not allowed.</p>\n<button id=\"dupCloseBtn\" type=\"button\" style=\"background:#0A1F3D;color:#fff;border:none;padding:11px 28px;border-radius:8px;font-weight:800;font-size:14px;cursor:pointer\">OK</button>\n</div>\n</div>\n\n</div>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var WEB_APP_URL = \"__NGI_SITE_URL__\";\n\n  var MIN_AGE = 17;\n  var MAX_CV_BYTES = 500 * 1024;\n  var MIN_FILL_SECONDS = 20;\n  var MONTHS = [\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"];\n\n  var submitting = false;\n  var pageLoadedAt = Date.now();\n  var submissionToken = generateToken(32);\n\n  try { window.localStorage.removeItem(\"ufaq_apf_submissions_2026_v1\"); } catch (e) {}\n\n  function generateToken(len) {\n    var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-\";\n    var out = \"\";\n    try {\n      if (window.crypto && window.crypto.getRandomValues) {\n        var arr = new Uint8Array(len);\n        window.crypto.getRandomValues(arr);\n        for (var i = 0; i < len; i++) out += chars[arr[i] % chars.length];\n        return out;\n      }\n    } catch (e) {}\n    for (var j = 0; j < len; j++) out += chars[Math.floor(Math.random() * chars.length)];\n    return out;\n  }\n\n  function validatePakMobile(input) {\n    var cleaned = String(input || \"\").trim().replace(/[\\s\\-()]/g, \"\");\n    var pkRegex = /^(?:\\+92|92|0)3[0-9]{9}$/;\n    if (!pkRegex.test(cleaned)) return { valid: false, normalized: \"\" };\n    var digitsOnly = cleaned.replace(/\\D/g, \"\");\n    var canonical = digitsOnly.indexOf(\"92\") === 0 ? \"0\" + digitsOnly.slice(2) : digitsOnly;\n    return { valid: true, normalized: canonical };\n  }\n\n  function $(id) { return document.getElementById(id); }\n  function pad(n) { return (\"0\" + n).slice(-2); }\n\n  function calcAge(y, m, d) {\n    var t = new Date();\n    var age = t.getFullYear() - y;\n    var mm = t.getMonth() + 1 - m;\n    if (mm < 0 || (mm === 0 && t.getDate() < d)) age--;\n    return age;\n  }\n\n  function formatBytes(bytes) {\n    if (bytes < 1024) return bytes + \" B\";\n    return (bytes / 1024).toFixed(1) + ",
    "\" KB\";\n  }\n\n  function readCvAsPayload(file) {\n    return new Promise(function (resolve, reject) {\n      if (!file) {\n        return reject(new Error(\"Please upload your CV / Resume.\"));\n      }\n      var name = String(file.name || \"\");\n      var m = /\\.([A-Za-z0-9]+)$/.exec(name);\n      var ext = m ? m[1].toLowerCase() : \"\";\n      var allowed = [\"pdf\", \"doc\", \"docx\", \"jpg\", \"jpeg\", \"png\"];\n\n      if (allowed.indexOf(ext) === -1) {\n        return reject(new Error(\"CV must be in PDF, DOCX, DOC, JPG, or PNG format.\"));\n      }\n      if (file.size < 100) {\n        return reject(new Error(\"Selected CV file looks empty or damaged.\"));\n      }\n      if (file.size > MAX_CV_BYTES) {\n        return reject(new Error(\"CV file size (\" + formatBytes(file.size) + \") exceeds the 500 KB maximum limit.\"));\n      }\n\n      var mimeMap = {\n        pdf: \"application/pdf\",\n        doc: \"application/msword\",\n        docx: \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n        jpg: \"image/jpeg\",\n        jpeg: \"image/jpeg\",\n        png: \"image/png\"\n      };\n      var expectedMime = mimeMap[ext] || file.type || \"application/octet-stream\";\n\n      var reader = new FileReader();\n      reader.onload = function () {\n        resolve({\n          name: name,\n          type: expectedMime,\n          data: reader.result\n        });\n      };\n      reader.onerror = function () {\n        reject(new Error(\"Could not read CV file. Please select the file again.\"));\n      };\n      reader.readAsDataURL(file);\n    });\n  }\n\n  function animateTitle() {\n    var el = $(\"projTitle\");\n    if (!el || el.getAttribute(\"data-animated\") === \"1\") return;\n    el.setAttribute(\"data-animated\", \"1\");\n    var txt = el.textContent.trim();\n    el.innerHTML = \"\";\n    txt.split(\"\").forEach(function (ch, i) {\n      var s = document.createElement(\"span\");\n      s.textContent = ch === \" \" ? \"\\u00A0\" : ch;\n      s.style.animationDelay = (i * 0.04) + \"s\";\n      el.appendChild(s);\n    });\n  }\n\n  function fillDob() {\n    var dayS = $(\"dobDay\"), monS = $(\"dobMonth\"), yrS = $(\"dobYear\");\n    if (!dayS || !monS || !yrS || dayS.options.length > 1) return;\n    var i, o;\n    for (i = 1; i <= 31; i++) {\n      o = document.createElement(\"option\");\n      o.value = i;\n      o.textContent = i;\n      dayS.appendChild(o);\n    }\n    for (i = 0; i < 12; i++) {\n      o = document.createElement(\"option\");\n      o.value = i + 1;\n      o.textContent = MONTHS[i];\n      monS.appendChild(o);\n    }\n    var cy = new Date().getFullYear();\n    for (i = cy - MIN_AGE; i >= cy - 70; i--) {\n      o = document.createElement(\"option\");\n      o.value = i;\n      o.textContent = i;\n      yrS.appendChild(o);\n    }\n  }\n\n  function toggleGuardianBox() {\n    var y = parseInt($(\"dobYear\").value, 10);\n    var m = parseInt($(\"dobMonth\").value, 10);\n    var d = parseInt($(\"dobDay\").value, 10);\n    var box = $(\"guardianBox\");\n    var gName = $(\"guardianName\");\n    var gRel = $(\"guardianRelation\");\n    var gPhone = $(\"guardianPhone\");\n    var gConf = $(\"guardianConfirm\");\n\n    if (!box) return false;\n\n    var show = false;\n    if (y && m && d) {\n      var chk = new Date(y, m - 1, d);\n      if (chk.getFullYear() === y && chk.getMonth() === m - 1 && chk.getDate() === d) {\n        var age = calcAge(y, m, d);\n        if (age === 17) show = true;\n      }\n    }\n\n    if (show) {\n      box.style.display = \"block\";\n      gName.setAttribute(\"required\", \"required\");\n      gRel.setAttribute(\"required\", \"required\");\n      gPhone.setAttrib",
    "ute(\"required\", \"required\");\n      gConf.setAttribute(\"required\", \"required\");\n    } else {\n      box.style.display = \"none\";\n      gName.removeAttribute(\"required\");\n      gRel.removeAttribute(\"required\");\n      gPhone.removeAttribute(\"required\");\n      gConf.removeAttribute(\"required\");\n    }\n    return show;\n  }\n\n  function bind(form) {\n    if (form.getAttribute(\"data-bound\") === \"1\") return;\n    form.setAttribute(\"data-bound\", \"1\");\n\n    var btn = $(\"submitBtn\");\n    var alertBox = $(\"formAlertBox\");\n    var formCard = $(\"formCard\");\n    var popup = $(\"successPopup\");\n    var closeBtn = $(\"popupCloseBtn\");\n    var dupPopup = $(\"duplicatePopup\");\n    var dupCloseBtn = $(\"dupCloseBtn\");\n    var cvInput = $(\"cvFileInput\");\n    var cvStatus = $(\"cvFileStatus\");\n\n    fillDob();\n    animateTitle();\n\n    [\"whatsappInput\", \"guardianPhone\", \"emergencyPhoneInput\"].forEach(function (id) {\n      var inp = $(id);\n      if (inp) {\n        inp.addEventListener(\"input\", function () {\n          this.value = this.value.replace(/[^\\d+]/g, \"\");\n        });\n      }\n    });\n\n    [\"dobDay\", \"dobMonth\", \"dobYear\"].forEach(function (id) {\n      var el = $(id);\n      if (el) el.addEventListener(\"change\", toggleGuardianBox);\n    });\n\n    if (cvInput) {\n      cvInput.addEventListener(\"change\", function () {\n        var f = this.files && this.files[0];\n        if (!f) { cvStatus.textContent = \"\"; return; }\n        var ext = (String(f.name || \"\").split(\".\").pop() || \"\").toLowerCase();\n        var allowed = [\"pdf\", \"doc\", \"docx\", \"jpg\", \"jpeg\", \"png\"];\n        if (allowed.indexOf(ext) === -1) {\n          cvStatus.style.color = \"#DC2626\";\n          cvStatus.textContent = \"Invalid format. Only PDF, DOCX, DOC, JPG, or PNG allowed.\";\n        } else if (f.size > MAX_CV_BYTES) {\n          cvStatus.style.color = \"#DC2626\";\n          cvStatus.textConten