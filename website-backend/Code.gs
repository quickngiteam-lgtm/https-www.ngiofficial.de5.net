/**
 * NGI COMPLETE WEBSITE — single-file Google Apps Script web app
 *
 * INSTALL:
 * 1. Open the website Apps Script project used by both forms.
 * 2. Back up old code; paste this entire file into Code.gs. Keep only one doGet/doPost.
 * 3. Save, choose setupWebsite, Run once, and grant requested permissions.
 * 4. Deploy > Manage deployments > Edit > New version. Execute as: Me. Access: Anyone.
 * 5. Open its /exec URL for the full site. /exec?health=1 returns a setup status.
 * 6. Test synthetic applications before collecting real submissions.
 *
 * Includes all six existing pages, navigation, original content, CSS, carousel,
 * responsive layouts, both application forms, local page images, backend routing,
 * private application storage and applicant confirmation emails.
 * Remote brand logos and fonts retain their original HTTPS references.
 * This file is a complete Apps Script-hosted website, not a static GitHub index.html.
 * No separate HTML, CSS, JavaScript, or image files need to be uploaded.
 *
 * Notifications are sent after server-confirmed success; an email quota problem
 * does not invalidate a saved record. All applicant contact details remain private.
 */
const NGI_NEW_APPLICATIONS_ID = 'NGI_NEW_APPLICATIONS_SHEET_ID';
const NGI_NEW_CV_FOLDER_ID = 'NGI_NEW_UFAQ_CV_FOLDER_ID';
const NGI_STORAGE_READY = 'NGI_NEW_STORAGE_READY';
const NGI_MEMBERSHIP_SHEET = 'Membership';
const NGI_UFAQ_SHEET = 'UFAQ';
const NGI_MEMBERSHIP_FIELDS = ['fullName', 'email', 'phone', 'district', 'city', 'education', 'institution', 'interest', 'availability', 'reason'];
const NGI_MEMBERSHIP_CODE_TTL = 600;
const NGI_MEMBERSHIP_HEADERS = ['Received At', 'Reference'].concat(NGI_MEMBERSHIP_FIELDS, ['Consent', 'Accuracy']);

/** Run once from the Apps Script editor as the deployment owner. */
function setupWebsite() {
  const active = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  const owner = String(Session.getEffectiveUser().getEmail() || '').toLowerCase();
  if (!active || active !== owner) throw new Error('Run setupWebsite as the project owner in the Apps Script editor.');
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) throw new Error('Website storage setup is busy. Try again.');
  try {
    const props = PropertiesService.getScriptProperties();
    let id = props.getProperty(NGI_NEW_APPLICATIONS_ID);
    if (!id) {
      const book = SpreadsheetApp.create('NGI New Applications');
      book.getSheets()[0].setName(NGI_MEMBERSHIP_SHEET);
      id = book.getId();
      props.setProperty(NGI_NEW_APPLICATIONS_ID, id);
    }
    const book = SpreadsheetApp.openById(id);
    setupApplicationsSheet_(book, NGI_MEMBERSHIP_SHEET, NGI_MEMBERSHIP_HEADERS);
    setupApplicationsSheet_(book, NGI_UFAQ_SHEET, ['Received At', 'Reference',
      'Request Token Hash', 'Request Content Hash'].concat(NGI_UFAQ_FIELDS, ['CV File ID']));
    SpreadsheetApp.flush();
    if (!props.getProperty(NGI_NEW_CV_FOLDER_ID)) {
      const folder = DriveApp.createFolder('NGI New UFAQ CVs');
      props.setProperty(NGI_NEW_CV_FOLDER_ID, folder.getId());
    }
    Logger.log('New applications spreadsheet: ' + book.getUrl());
    Logger.log('New UFAQ CV folder: ' + DriveApp.getFolderById(props.getProperty(NGI_NEW_CV_FOLDER_ID)).getUrl());
    const quota = MailApp.getRemainingDailyQuota();
    props.setProperty(NGI_STORAGE_READY, '1');
    Logger.log('Remaining daily email recipient quota: ' + quota);
  } finally { lock.releaseLock(); }
}

function setupApplicationsSheet_(book, name, headers) {
  const sheet = book.getSheetByName(name) || book.insertSheet(name);
  if (sheet.getLastRow() === 0) sheet.appendRow(headers);
  sheet.setFrozenRows(1);
}

function doGet(e) {
  const params = (e && e.parameter) || {};
  if (String(params.health || '') === '1') {
    const props = PropertiesService.getScriptProperties();
    const sheetConfigured = props.getProperty(NGI_STORAGE_READY) === '1' && !!props.getProperty(NGI_NEW_APPLICATIONS_ID);
    return membershipJson_({success:true,service:'NGI Website',forms:['membership','ufaq'],
      membershipConfigured:sheetConfigured,ufaqConfigured:sheetConfigured && !!props.getProperty(NGI_NEW_CV_FOLDER_ID)});
  }
  return renderWebsite_(params.page, params.section);
}

/** Single public HTML-service submission entry point; same validation as the REST API. */
function submitWebsiteApplication(raw) {
  return doPost({postData: {contents: typeof raw === 'string' ? raw : ''}}).getContent();
}

function doPost(e) {
  const raw = e && e.postData && e.postData.contents;
  // UFAQ includes a base64-encoded CV (maximum 500 KB in the original form).
  if (typeof raw !== 'string' || !raw || raw.length > 1000000) {
    return membershipJson_({success: false, message: 'Invalid request.'});
  }
  let data;
  try { data = JSON.parse(raw); } catch (_) {
    return membershipJson_({success: false, message: 'Invalid request.'});
  }
  if (!data || typeof data !== 'object' || Array.isArray(data)) {
    return membershipJson_({success: false, message: 'Invalid request.'});
  }
  if (Object.prototype.hasOwnProperty.call(data, 'fields')) {
    let request;
    try { request = validateUfaqApplication_(data); }
    catch (error) {
      const message = error.message;
      const safeMessages = ['Please complete the UFAQ application and upload a valid CV.',
        'Please enter a valid date of birth.', 'Please check the UFAQ age requirement.',
        'Guardian details and consent are required for applicants under 18.',
        'Please check the Pakistani mobile numbers.'];
      return membershipJson_({success:false,message:safeMessages.includes(message) ? message : safeMessages[0]});
    }
    return handleUfaqApplication_(request);
  }
  if (raw.length > 14000) return membershipJson_({success:false,message:'Invalid request.'});
  return handleMembershipApplication_(data);
}

const NGI_UFAQ_LIMITS = {
    Full_Name:150, Gender:50, Date_of_Birth:10, WhatsApp_Number:25, Email_Address:150,
    District:100, City:100, Complete_Address:500, Guardian_Full_Name:150,
    Guardian_Relationship:80, Guardian_Phone:25, Guardian_Consent_Confirmed:3,
    Education_Level:100, Institution_Name:200, Preferred_Role:150, Previous_Experience:100,
    Skills:2000, Reason_to_Join:3000, Hours_Per_Week:30, Travel_Within_District:100,
    Emergency_Contact_Name:150, Emergency_Contact_Number:25,
    Privacy_Consent:6, Accuracy_Declaration:6, Compensation_Policy_Agreed:6
};
const NGI_UFAQ_FIELDS = Object.keys(NGI_UFAQ_LIMITS);

/** Validate and normalize the public UFAQ request before storing an application. */
function validateUfaqApplication_(data) {
  const invalid = 'Please complete the UFAQ application and upload a valid CV.';
  const fields = data.fields;
  if (!fields || typeof fields !== 'object' || Array.isArray(fields) || fields.website ||
      typeof data.token !== 'string' || !/^[A-Za-z0-9_-]{32}$/.test(data.token) ||
      !Number.isSafeInteger(data.elapsedSeconds) || data.elapsedSeconds < 20) {
    throw new Error(invalid);
  }
  const clean = {website:''};
  for (const name of NGI_UFAQ_FIELDS) {
    const value = fields[name];
    if (typeof value !== 'string' || value.length > NGI_UFAQ_LIMITS[name] || (!name.startsWith('Guardian_') && !value.trim())) {
      throw new Error(invalid);
    }
    clean[name] = value.trim();
    if (clean[name].startsWith('=')) throw new Error(invalid);
  }
  clean.Email_Address = clean.Email_Address.toLowerCase();
  if (!/^[^\s@,;<>()"']+@[^\s@,;<>()"']+\.[A-Za-z]{2,}$/.test(clean.Email_Address)) throw new Error(invalid);
  for (const name of ['Privacy_Consent', 'Accuracy_Declaration', 'Compensation_Policy_Agreed']) {
    if (clean[name] !== 'Agreed') throw new Error(invalid);
  }
  const today = Utilities.formatDate(new Date(), 'Asia/Karachi', 'yyyy-MM-dd');
  const dob = clean.Date_of_Birth;
  const date = new Date(dob + 'T00:00:00Z');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(dob) || !Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== dob) {
    throw new Error('Please enter a valid date of birth.');
  }
  const age = Number(today.slice(0, 4)) - Number(dob.slice(0, 4)) - (today.slice(5) < dob.slice(5) ? 1 : 0);
  if (age < 17 || age > 120) throw new Error('Please check the UFAQ age requirement.');
  const phones = ['WhatsApp_Number', 'Emergency_Contact_Number'];
  if (age < 18) {
    if (!clean.Guardian_Full_Name || !clean.Guardian_Relationship || clean.Guardian_Consent_Confirmed !== 'Yes') {
      throw new Error('Guardian details and consent are required for applicants under 18.');
    }
    phones.push('Guardian_Phone');
  } else {
    for (const name of Object.keys(clean)) if (name.startsWith('Guardian_')) clean[name] = '';
  }
  for (const name of phones) {
    // Store all mobile numbers in the national format.
    const phone = clean[name].replace(/[\s()-]/g, '').replace(/^\+?92/, '0');
    if (!/^03\d{9}$/.test(phone)) throw new Error('Please check the Pakistani mobile numbers.');
    clean[name] = phone;
  }
  const cv = data.cv;
  const signatures = {
    pdf:['application/pdf',[37,80,68,70,45]],
    doc:['application/msword',[208,207,17,224,161,177,26,225]],
    docx:['application/vnd.openxmlformats-officedocument.wordprocessingml.document',[80,75,3,4]],
    jpg:['image/jpeg',[255,216,255]],
    jpeg:['image/jpeg',[255,216,255]],
    png:['image/png',[137,80,78,71,13,10,26,10]]
  };
  if (!cv || typeof cv.name !== 'string' || !/^[^/\\\u0000-\u001f\u007f]{1,180}$/.test(cv.name) ||
      typeof cv.data !== 'string' || cv.data.length > 683000) throw new Error(invalid);
  const ext = cv.name.split('.').pop().toLowerCase();
  const type = Object.prototype.hasOwnProperty.call(signatures, ext) && signatures[ext];
  const encoded = /^data:[^;,]*;base64,([A-Za-z0-9+/]+={0,2})$/.exec(cv.data);
  if (!cv.name.includes('.') || !type || cv.type !== type[0] || !encoded || encoded[1].length % 4 !== 0) throw new Error(invalid);
  const padding = encoded[1].endsWith('==') ? 2 : (encoded[1].endsWith('=') ? 1 : 0);
  const bytes = encoded[1].length * 3 / 4 - padding;
  const prefix = Utilities.base64Decode(encoded[1].slice(0, 12));
  if (bytes < 100 || bytes > 500 * 1024 || !type[1].every((v, i) => (prefix[i] & 255) === v)) throw new Error(invalid);
  return {token:data.token, elapsedSeconds:data.elapsedSeconds, fields:clean,
    cv:{name:cv.name,type:type[0],extension:ext,encoded:encoded[1]}};
}

/** Called with the script lock held for each new UFAQ submission. */
function reserveUfaqRequest_(props) {
  const now = new Date().toISOString();
  const hour = now.slice(0, 13);
  const day = now.slice(0, 10);
  const previous = JSON.parse(props.getProperty('NGI_UFAQ_REQUEST_QUOTA') || '{}');
  const hourly = previous.hour === hour ? previous.hourly : 0;
  const daily = previous.day === day ? previous.daily : 0;
  if (hourly >= 60 || daily >= 300) return false;
  props.setProperty('NGI_UFAQ_REQUEST_QUOTA', JSON.stringify({hour:hour, day:day, hourly:hourly + 1, daily:daily + 1}));
  return true;
}

/** Save UFAQ applications and CVs in the new storage, with safe retries. */
function handleUfaqApplication_(request) {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty(NGI_NEW_APPLICATIONS_ID);
  const folderId = props.getProperty(NGI_NEW_CV_FOLDER_ID);
  if (!id || !folderId || props.getProperty(NGI_STORAGE_READY) !== '1') return membershipJson_({success:false,message:'UFAQ registration is not yet available.'});
  const tokenHash = membershipDigest_(request.token);
  const contentHash = membershipDigest_(JSON.stringify([request.fields, request.cv.name, request.cv.encoded]));
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return membershipJson_({success:false,message:'UFAQ is busy. Please try again later.'});
  let reference;
  try {
    const sheet = SpreadsheetApp.openById(id).getSheetByName(NGI_UFAQ_SHEET);
    const last = sheet.getLastRow();
    if (last > 1) {
      const match = sheet.getRange(2, 3, last - 1, 1).createTextFinder(tokenHash)
        .matchEntireCell(true).matchCase(true).findNext();
      if (match) {
        const row = match.getRow();
        if (sheet.getRange(row, 4).getDisplayValue() !== contentHash) {
          return membershipJson_({success:false,message:'This form was already submitted. Contact NGI if you need to correct your application.'});
        }
        return membershipJson_({success:true,applicationId:sheet.getRange(row, 2).getDisplayValue()});
      }
      // Search only the UFAQ tab, so this address can also submit one Membership application.
      const emailColumn = 5 + NGI_UFAQ_FIELDS.indexOf('Email_Address');
      const existingEmail = sheet.getRange(2, emailColumn, last - 1, 1)
        .createTextFinder(request.fields.Email_Address).matchEntireCell(true).matchCase(false).findNext();
      if (existingEmail) {
        return membershipJson_({success:false,message:'Only one UFAQ application per email address is allowed. Contact NGI if you need assistance.'});
      }
    }
    if (!reserveUfaqRequest_(props)) return membershipJson_({success:false,message:'UFAQ is busy. Please try again later.'});
    const folder = DriveApp.getFolderById(folderId);
    // A retry after an uncertain Sheets write reuses the same upload.
    const fileName = 'UFAQ-CV-' + membershipDigest_(tokenHash + ':' + contentHash).replace(/=+$/, '') + '.' + request.cv.extension;
    const matches = folder.getFilesByName(fileName);
    const file = matches.hasNext() ? matches.next() : folder.createFile(Utilities.newBlob(
      Utilities.base64Decode(request.cv.encoded), request.cv.type, fileName));
    reference = 'UFAQ-' + Utilities.getUuid().replace(/-/g, '').slice(0, 16).toUpperCase();
    sheet.appendRow([new Date(), reference, tokenHash, contentHash].concat(
      NGI_UFAQ_FIELDS.map(name => membershipSafeCell_(request.fields[name])), [file.getId()]));
    SpreadsheetApp.flush();
  } catch (_) {
    return membershipJson_({success:false,message:'UFAQ submission could not be confirmed. Retry from this tab to use the same application.'});
  } finally { lock.releaseLock(); }
  const receiptSent = sendWebsiteReceipt_('UFAQ Volunteer', reference, request.fields.Email_Address);
  return membershipJson_({success:true,applicationId:reference,receiptSent:receiptSent});
}

function handleMembershipApplication_(data) {
  if (!data || typeof data !== 'object' || Array.isArray(data) || data.website ||
      typeof data.email !== 'string' || data.email.length > 150) {
    return membershipJson_({success: false, message: 'Invalid request.'});
  }
  const email = data.email.trim().toLowerCase();
  if (!/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9-]+(?:\.[a-z0-9-]+)+$/.test(email)) {
    return membershipJson_({success: false, message: 'Please enter a valid email address.'});
  }
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty(NGI_NEW_APPLICATIONS_ID);
  if (!id || props.getProperty(NGI_STORAGE_READY) !== '1') return membershipJson_({success:false,message:'Membership registration is not yet available.'});
  if (data.action === 'sendCode') return sendMembershipCode_(email, props);
  if (data.action !== 'apply' || data.consent !== 'on' || data.accuracy !== 'on') {
    return membershipJson_({success: false, message: 'Please complete all required fields and declarations.'});
  }
  const limits = {fullName:100,email:150,phone:20,district:80,city:80,education:80,institution:150,interest:100,availability:60,reason:1200};
  const required = ['fullName','email','phone','district','city','education','interest','reason'];
  const clean = {};
  for (const field of NGI_MEMBERSHIP_FIELDS) {
    if (data[field] != null && typeof data[field] !== 'string') return membershipJson_({success:false,message:'Invalid field.'});
    clean[field] = (data[field] || '').trim();
    if (clean[field].length > limits[field] || (required.includes(field) && !clean[field])) return membershipJson_({success:false,message:'Please review required fields.'});
  }
  clean.email = email;
  clean.phone = clean.phone.replace(/[\s()-]/g, '').replace(/^\+?92/, '0');
  if (!/^03\d{9}$/.test(clean.phone)) {
    return membershipJson_({success:false,message:'Please enter a valid Pakistani mobile number.'});
  }
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return membershipJson_({success:false,message:'Please try again in a moment.'});
  let reference;
  try {
    const cache = CacheService.getScriptCache();
    const key = 'membership-code:' + membershipDigest_(email);
    const code = typeof data.code === 'string' ? data.code.trim().toUpperCase() : '';
    const challenge = typeof data.challenge === 'string' && /^[a-f0-9-]{36}$/.test(data.challenge) ? data.challenge : '';
    const digest = challenge && cache.get(key + ':' + challenge);
    const attemptsKey = key + ':' + challenge + ':attempts';
    if (digest && /^[A-F0-9]{12}$/.test(code) && digest !== membershipDigest_(code)) {
      const attempts = Number(cache.get(attemptsKey) || 0) + 1;
      cache.put(attemptsKey, String(attempts), NGI_MEMBERSHIP_CODE_TTL);
      if (attempts >= 5) cache.remove(key + ':' + challenge);
    }
    if (!digest || !/^[A-F0-9]{12}$/.test(code) || digest !== membershipDigest_(code)) {
      return membershipJson_({success:false,message:'Enter a valid verification code or request a new one.'});
    }
    const sheet = SpreadsheetApp.openById(id).getSheetByName(NGI_MEMBERSHIP_SHEET);
    const last = sheet.getLastRow();
    if (last > 1) {
      const match = sheet.getRange(2, 4, last - 1, 1).createTextFinder(email)
        .matchEntireCell(true).matchCase(false).findNext();
      if (match) {
        const reference = sheet.getRange(match.getRow(), 2).getDisplayValue();
        cache.remove(key + ':' + challenge);
        return membershipJson_({success:true,reference:reference});
      }
    }
    reference = 'NGI-M-' + Utilities.getUuid().split('-')[0].toUpperCase();
    sheet.appendRow([new Date(), reference].concat(NGI_MEMBERSHIP_FIELDS.map(field => membershipSafeCell_(clean[field])), ['Agreed', 'Confirmed']));
    SpreadsheetApp.flush();
    cache.remove(key + ':' + challenge);
  } catch (_) {
    return membershipJson_({success:false,message:'Unable to save the application. Please try again.'});
  } finally { lock.releaseLock(); }
  const receiptSent = sendWebsiteReceipt_('NGI Membership', reference, clean.email);
  return membershipJson_({success:true,reference:reference,receiptSent:receiptSent});
}

function sendMembershipCode_(email, props) {
  const unavailable = {success:false,message:'Unable to send a code right now. Please try again later.'};
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return membershipJson_(unavailable);
  try {
    const cache = CacheService.getScriptCache();
    const key = 'membership-code:' + membershipDigest_(email);
    const cooldownKey = key + ':cooldown';
    if (cache.get(cooldownKey)) {
      return membershipJson_({success:false,message:'Please wait one minute before requesting another code.'});
    }
    const now = new Date().toISOString();
    const day = now.slice(0, 10);
    const hour = now.slice(0, 13);
    const quota = JSON.parse(props.getProperty('MEMBERSHIP_EMAIL_QUOTA') || '{}');
    const dailyCount = quota.day === day ? quota.dailyCount : 0;
    const hourlyCount = quota.hour === hour ? quota.hourlyCount : 0;
    if (dailyCount >= 75 || hourlyCount >= 15 || MailApp.getRemainingDailyQuota() < 1) {
      return membershipJson_(unavailable);
    }
    const challenge = Utilities.getUuid();
    const code = Utilities.getUuid().replace(/-/g, '').slice(0, 12).toUpperCase();
    props.setProperty('MEMBERSHIP_EMAIL_QUOTA', JSON.stringify({
      day:day, hour:hour, dailyCount:dailyCount + 1, hourlyCount:hourlyCount + 1
    }));
    cache.put(cooldownKey, '1', 60);
    MailApp.sendEmail(email, 'NGI membership verification code',
      'Your NGI membership verification code is ' + code + '. It expires in 10 minutes. If you did not request this code, you can ignore this email.');
    cache.put(key + ':' + challenge, membershipDigest_(code), NGI_MEMBERSHIP_CODE_TTL);
    return membershipJson_({success:true,codeSent:true,challenge:challenge});
  } catch (_) {
    return membershipJson_(unavailable);
  } finally { lock.releaseLock(); }
}

function membershipDigest_(value) {
  return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value));
}

function membershipSafeCell_(value) {
  // Preserve text, including leading zeroes in mobile numbers; prevent spreadsheet formula injection.
  return "'" + String(value);
}

function membershipJson_(data) {
  return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);
}

/** Send only to the applicant after the application has been saved. */
function sendWebsiteReceipt_(form, reference, applicant) {
  try {
    if (MailApp.getRemainingDailyQuota() < 1) throw new Error('Daily mail quota exhausted.');
    MailApp.sendEmail({
      to: applicant,
      subject: 'NGI confirmation: ' + form + ' application received',
      body: 'Thank you for applying to the Next Generation Initiative (NGI). We have received your ' +
        form + ' application.\n\nYour reference number is ' + reference +
        '. Please keep it for your records.\n\nThe relevant NGI team will review your application and contact you ' +
        'with information about the next steps.\n\nKind regards,\nNext Generation Initiative (NGI)',
      name: 'NGI Applications'
    });
    return true;
  } catch (_) {
    console.error('NGI applicant confirmation could not be sent. Check mail authorization and quota.');
    return false;
  }
}

